{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloverEye",
  "version": "0.1.0",
  "identifier": "app.clovereye.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CloverEye",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: blob: https://i.4cdn.org https://s.4cdn.org; media-src 'self' blob: https://i.4cdn.org; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Unofficial desktop client for 4chan",
    "longDescription": "CloverEye reads boards and threads, watches threads and fits videos to a board's limits. It is not affiliated with or endorsed by 4chan.",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "section": "web",
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      }
    }
  }
}
