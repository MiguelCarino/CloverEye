{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Every CloverEye window (main and the extra ones, w-*): the app commands the UI calls, settings events, window controls for the custom title bar, and opening the site's rules page in the system browser. The hidden post helper is not in this list; it has its own capability with one command.",
  "windows": [
    "main",
    "w-*"
  ],
  "permissions": [
    "allow-get-settings",
    "allow-set-settings",
    "allow-check-ffmpeg",
    "allow-fetch-boards",
    "allow-fetch-catalog",
    "allow-fetch-thread",
    "allow-open-post-window",
    "allow-post-agent",
    "allow-post-agent-show",
    "allow-open-window",
    "allow-save-media",
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.4chan.org/rules"
        }
      ]
    }
  ]
}
